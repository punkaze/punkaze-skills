{
  "name": "Sample API",
  "baseUrl": "http://localhost:3000",
  "auth": { "type": "bearer" },
  "ignore": ["node_modules", ".git"],
  "environments": [
    { "name": "dev", "baseUrl": "http://localhost:3000", "secretVars": ["authToken"] }
  ],
  "routes": [
    { "method": "POST", "path": "/auth/login", "name": "Login",
      "body": { "email": "user@example.com", "password": "secret" },
      "auth": false, "script": "token-capture", "tests": ["status-2xx"],
      "docs": "Authenticate and capture the token." },
    { "method": "GET", "path": "/users", "name": "List Users",
      "query": { "page": 1, "limit": 10 }, "auth": true, "tests": ["status-2xx"] },
    { "method": "GET", "path": "/users/:id", "name": "Get User",
      "auth": true, "tests": ["status-2xx"] }
  ]
}
