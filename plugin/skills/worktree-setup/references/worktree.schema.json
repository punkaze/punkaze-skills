{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "worktree project config",
  "type": "object",
  "required": ["project", "remoteMatch", "baseBranch", "repos"],
  "properties": {
    "project": { "type": "string" },
    "remoteMatch": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "baseBranch": { "type": "string" },
    "branchPrefixes": { "type": "array", "items": { "type": "string" } },
    "parentHint": { "type": ["string", "null"] },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "dir"],
        "properties": {
          "key": { "type": "string" },
          "dir": { "type": "string" },
          "install": { "type": "string" },
          "baseBranch": { "type": ["string", "null"] },
          "envFiles": { "type": "array", "items": { "type": "string" } },
          "role": { "type": "string" }
        }
      }
    },
    "coupling": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repos", "sharedSurface"],
        "properties": {
          "repos": { "type": "array", "items": { "type": "string" } },
          "sharedSurface": { "type": "string" },
          "grep": { "type": "array", "items": { "type": "string" } },
          "contractPath": { "type": ["string", "null"] },
          "notes": { "type": "string" }
        }
      }
    },
    "neverCouple": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "caveats": { "type": "array", "items": { "type": "string" } }
  }
}
